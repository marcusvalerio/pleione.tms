{
  "name": "pleione-tms",
  "version": "0.1.0",
  "private": true,
  "description": "PLEIONE TMS — gestão de transportes do ecossistema ASTRAEUS (ATLAS.ERP · ORION.WMS · PLEIONE.TMS)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/db.ts seed"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.54.0",
    "next": "^16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.23",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
