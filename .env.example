# Conexão Postgres (Neon). Sem ela, o app usa os dados de demonstração em memória.
# Pegue no console do Neon: projeto pleione-tms → Connect.
DATABASE_URL=

# Opcionais: servidores próprios de rotas e de endereço (os públicos são só para demonstração)
# OSRM_URL=https://router.project-osrm.org
# GEOCODER_URL=https://nominatim.openstreetmap.org

# Segredo do cookie de sessão (≥ 32 caracteres). Obrigatório em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
